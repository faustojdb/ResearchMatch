{
  "mcpServers": {
    "research-match": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "run",
        "--frozen",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/research_match_mcp.py"
      ],
      "env": {
        "RESEARCH_MATCH_DB": "${CLAUDE_PLUGIN_DATA}/research_match.db"
      }
    }
  }
}
