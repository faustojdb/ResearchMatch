# Virtual environment
.venv/
venv/

# Database files
*.db
*.db-shm
*.db-wal

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude local config
.claude/

# Firebase emulator logs
firestore-debug.log
ui-debug.log
*-debug.log

# Build artifacts (produced by `mcpb pack`)
*.dxt
*.mcpb
*.zip

# Reference repos (large, not committed)
research_refs/

# Ad-hoc test scripts
test_whatsapp_*.py
test_deep_search_real.py

# Production credentials (NEVER commit) — broad glob, not just the exact filename,
# so accidental duplicates/backups (e.g. "firebase-credentials1.json") are also caught
*credential*.json
*.pem
.env
!.env.example
