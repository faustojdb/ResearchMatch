# Research Match — environment template.
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Local-first mode needs NONE of these — it runs on SQLite with no keys.

# --- Identity (local-first) ---------------------------------------------------
# The email that identifies YOU on this install. In local mode this is the only
# identity the server trusts. Only its SHA-256 hash is stored.
RESEARCH_MATCH_USER_EMAIL=you@example.com

# --- Storage backend ----------------------------------------------------------
# Leave unset for local SQLite (default, recommended). Set to "firestore" for the
# shared backend (requires GOOGLE_APPLICATION_CREDENTIALS).
# RESEARCH_MATCH_BACKEND=firestore
# RESEARCH_MATCH_DB=./research_match.db

# --- Firebase / Firestore (only for the shared backend) -----------------------
# Path to a Google service-account JSON. Keep this file OUTSIDE the repo and load
# it from a secrets manager in production. Never commit it.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-credentials.json

# --- Algolia (optional full-text cold search) ---------------------------------
# Prefer a SEARCH-ONLY key on any client/edge path; the admin key can rewrite the
# index. Cold search falls back to keyword matching if these are unset.
# ALGOLIA_APP_ID=your_app_id
# ALGOLIA_API_KEY=your_search_only_key
# ALGOLIA_INDEX_NAME=research_commits

# --- GitHub App (optional bilateral repo access) ------------------------------
# GITHUB_APP_ID=000000
# GITHUB_APP_PRIVATE_KEY=/secure/path/app-private-key.pem
# GITHUB_APP_SLUG=your-app-slug

# --- Embedding worker (optional tuning) ---------------------------------------
# Embeddings run in a separate process (src/embedding_worker.py) started on first use.
# RESEARCH_MATCH_EMBEDDINGS_WARMUP=1            # start it at server startup instead
# RESEARCH_MATCH_EMBEDDINGS_READY_TIMEOUT=300   # seconds to wait for the model (first run downloads it)
# RESEARCH_MATCH_EMBEDDINGS_REQUEST_TIMEOUT=120 # seconds per similarity request
# RESEARCH_MATCH_EMBEDDINGS_IDLE_SECONDS=900    # stop the worker after this much inactivity
# RESEARCH_MATCH_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- OpenAlex novelty grounding (optional) ------------------------------------
# OpenAlex needs no API key. Set a contact email for the polite pool, or disable.
# RESEARCH_MATCH_OPENALEX_MAILTO=you@example.com
# RESEARCH_MATCH_DISABLE_OPENALEX=1

# --- Remote transport hardening (only when serving over HTTP) -----------------
# Comma-separated Host allow-list for DNS-rebinding protection.
# RESEARCH_MATCH_ALLOWED_HOSTS=your-host.run.app,localhost,127.0.0.1

# --- Logging ------------------------------------------------------------------
RESEARCH_MATCH_LOG_FORMAT=text
RESEARCH_MATCH_LOG_LEVEL=INFO
